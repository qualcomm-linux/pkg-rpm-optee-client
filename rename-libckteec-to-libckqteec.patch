optee: Re-name libckteec for QTEE

Origin: upstream, https://github.com/qualcomm/minkipc/commit/f9b8329a4b7de1dc8ca0de036f968fa8617a6dff

diff -ruN optee_client-4.0.0.orig/CMakeLists.txt optee_client-4.0.0.new/CMakeLists.txt
--- optee_client-4.0.0.orig/CMakeLists.txt	2026-09-03 02:11:16.916257254 +0530
+++ optee_client-4.0.0.new/CMakeLists.txt	2026-09-03 02:13:05.142752766 +0530
@@ -1,5 +1,5 @@
 cmake_minimum_required(VERSION 3.10)
-project(ckteec
+project(ckqteec
 	VERSION 0.1.0
 	LANGUAGES C)
 
@@ -64,9 +64,9 @@ set(SRC
 ################################################################################
 # Built library
 ################################################################################
-add_library(ckteec SHARED ${SRC})
+add_library(ckqteec SHARED ${SRC})
 
-set_target_properties(ckteec PROPERTIES
+set_target_properties(ckqteec PROPERTIES
 	VERSION ${PROJECT_VERSION}
 	SOVERSION ${PROJECT_VERSION_MAJOR}
 )
@@ -74,7 +74,7 @@ set_target_properties(ckteec PROPERTIES
 ################################################################################
 # Flags always set
 ################################################################################
-target_compile_definitions(ckteec
+target_compile_definitions(ckqteec
 	PRIVATE -D_GNU_SOURCE
 	PRIVATE -DBINARY_PREFIX="LT"
 )
@@ -86,14 +86,14 @@ target_compile_definitions(ckteec
 ################################################################################
 # Public and private header and library dependencies
 ################################################################################
-target_include_directories(ckteec
+target_include_directories(ckqteec
 	PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/libckteec/include>
 	$<INSTALL_INTERFACE:libckteec/include>
 	PRIVATE libckteec/src
 	PRIVATE include
 )
 
-target_link_libraries(ckteec
+target_link_libraries(ckqteec
 	PRIVATE pthread
 	PRIVATE minkteec
 	PRIVATE minkadaptor
@@ -103,7 +103,7 @@ target_link_libraries(ckteec
 ################################################################################
 # Install targets
 ################################################################################
-install(TARGETS ckteec
+install(TARGETS ckqteec
 	DESTINATION ${CMAKE_INSTALL_LIBDIR}
 )
 
